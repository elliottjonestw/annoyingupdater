{
  "manifest_version": 3,
  "name": "Annoying Updater Companion",
  "version": "1.0",
  "description": "Share installed extension metadata with Annoying Updater on this Mac.",
  "permissions": [
    "management",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Annoying Updater"
  },
  "key": "",
  "background": {
    "service_worker": "background.js"
  }
}
