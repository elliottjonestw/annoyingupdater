{
  "manifest_version": 3,
  "name": "upd8er Companion",
  "version": "1.0",
  "description": "Share installed extension metadata with upd8er on this Mac.",
  "permissions": [
    "management",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "upd8er"
  },
  "background": {
    "scripts": [
      "bridge.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-companion@annoyingupdater.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
